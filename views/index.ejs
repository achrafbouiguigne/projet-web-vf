<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <link rel="icon" type="image/x-icon" href="/inpt.ico">
    <style>
        /* General Styles */
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f9;
            color: #333;
        }

        header {
            background-color: #004080;
            color: white;
            text-align: center;
            padding: 20px 0;
            border-bottom: 4px solid #0066cc;
        }

        header h1 {
            margin: 0;
            font-size: 2.5rem;
        }

        .header-image {
            width: 80px;
            height: 80px;
            margin-top: 10px;
            border-radius: 50%;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .header-image:hover {
            transform: scale(1.1);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
        }

        main {
            text-align: center;
            margin: 40px auto;
            padding: 20px;
            max-width: 800px;
            background-color: white;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
        }

        main h1 {
            color: #004080;
            font-size: 2rem;
            margin-bottom: 20px;
        }

        main a {
            display: inline-block;
            margin: 10px;
            padding: 12px 20px;
            background-color: #004080;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
            font-size: 1rem;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }

        main a:hover {
            background-color: #00264d;
            transform: scale(1.05);
        }

        footer {
            background-color: #222;
            color: #f0f0f0;
            text-align: center;
            padding: 20px 0;
            font-size: 0.9rem;
        }

        footer a {
            color: #4db8ff;
            text-decoration: none;
            margin: 0 10px;
            font-weight: bold;
            transition: color 0.3s ease;
        }

        footer a:hover {
            color: #ffd700;
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <header>
        <h1>Bienvenue au site des réservations de l'INPT</h1>
        <a href="https://www.inpt.ac.ma/">
            <img src="/images/inpt.png" alt="INPT Logo" class="header-image">
        </a>
    </header>
    <main>
        <h1>Bienvenue !</h1>
        <a href="/login">Se connecter</a>
        <a href="/register">S'inscrire</a>
    </main>
    <footer>
        <p>© 2024 INPT. Tous droits réservés.</p>
        <p>Créé par <strong>Achraf Bouiguigne et Mohammed Errouh</strong></p>
    </footer>
    
</body>
</html>
